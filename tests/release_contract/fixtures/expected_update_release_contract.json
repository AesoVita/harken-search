{
  "authority_order": [
    "docs/superpowers/specs/2026-07-28-aris-auto-update-design.md",
    "committed updater code and tests",
    "docs/superpowers/plans/2026-07-28-aris-auto-update-release-pipeline.md"
  ],
  "source": {
    "kind": "GitHub Releases",
    "repository": "xindong/aris",
    "testing_api_path": "/repos/xindong/aris/releases",
    "stable_api_path": "/repos/xindong/aris/releases/latest"
  },
  "artifacts": {
    "bootstrap": "HarkenSearchBootstrap.exe",
    "update_zip": "Aris-{version}-win-x64-update.zip",
    "installer": "HarkenSearch-{version}-win-x64-setup.exe",
    "testing_manifest": "manifest-win-x64-testing.json",
    "stable_manifest": "manifest-win-x64-stable.json",
    "detached_signature_suffix": ".sig"
  },
  "canonical_manifest": {
    "schema_version": 1,
    "builder": "tools/build_update_manifest.py",
    "signed_payload": "raw manifest bytes",
    "signature_encoding": "lowercase hexadecimal",
    "asset_role": "immutable update ZIP only"
  },
  "release_side_controls": [
    "deterministic_update_zip_with_bootstrap",
    "exact_portable_installer_manifest_identity",
    "hash_size_version_build_id_data_compatibility_binding",
