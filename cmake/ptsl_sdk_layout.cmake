# Supports the SDK include/lib/bin distribution and the flat built drop.
function(aris_resolve_ptsl_sdk root include_out library_out runtime_out)
    if(NOT EXISTS "${root}/include/PTSLC_CPP/CppPTSLClient.h")
        message(FATAL_ERROR "PTSL SDK header is missing under ${root}/include")
    endif()
    if(EXISTS "${root}/lib/PTSLC_CPP.lib")
        set(library "${root}/lib/PTSLC_CPP.lib")
    elseif(EXISTS "${root}/PTSLC_CPP.lib")
        set(library "${root}/PTSLC_CPP.lib")
    else()
        message(FATAL_ERROR "PTSL SDK library is missing under ${root}")
    endif()
    if(EXISTS "${root}/bin/PTSLC_CPP.dll")
        set(runtime "${root}/bin/PTSLC_CPP.dll")
    else()
        set(runtime "${root}/PTSLC_CPP.dll")
    endif()
    set(${include_out} "${root}/include" PARENT_SCOPE)
    set(${library_out} "${library}" PARENT_SCOPE)
    set(${runtime_out} "${runtime}" PARENT_SCOPE)
endfunction()
